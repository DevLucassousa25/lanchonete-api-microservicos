# Copie para ".env" (mesma pasta do docker-compose.yml). O .env NÃO vai para o Git.

# ---------- Segurança ----------
# Segredo usado para assinar/validar os tokens JWT em TODOS os serviços (mínimo 32 caracteres)
JWT_SECRET=troque-este-segredo-em-producao-0123456789abcdef
JWT_TTL_MINUTOS=60
# true mostra stack trace nos erros — só para depurar, nunca em produção
APP_DEBUG=false

# ---------- Admin inicial (criado na primeira subida) ----------
ADMIN_EMAIL=admin@lanchonete.dev
ADMIN_PASSWORD=admin12345

# ---------- Pagamento ----------
# fake = Pix simulado (confirma pelo webhook manual)  |  mercadopago = Pix real (sandbox ou produção)
PAGAMENTO_GATEWAY=fake

# Mercado Pago > Suas integrações > sua aplicação > Testes > Credenciais de teste > Access Token
MERCADOPAGO_ACCESS_TOKEN=

# Só com credenciais de TESTE: "APRO" faz o Mercado Pago aprovar o Pix automaticamente.
# Em produção deixe vazio (usa o nome do cliente).
MERCADOPAGO_TEST_PAYER_NAME=APRO

# Opcional: URL pública para webhooks do MP (ex.: https://abc.ngrok-free.app/api/webhooks/pix)
MERCADOPAGO_NOTIFICATION_URL=
